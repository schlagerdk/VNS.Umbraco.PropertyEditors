<Project Sdk="Microsoft.NET.Sdk.Razor">
	<!-- VNS Multi Language Textbox for Umbraco 17: a property editor that stores a text per language. Only static
       files: the backoffice code in wwwroot, built from ../src with npm run build. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>VNS.MultiLanguageTextbox</PackageId>
		<Version>2.0.0</Version>
		<Authors>VNS</Authors>
		<Description>A property editor for the Umbraco backoffice that stores a text for each of the site's languages in one property.</Description>
		<PackageTags>umbraco;umbraco-marketplace;vns;property-editor;multilingual</PackageTags>
		<Copyright>2026</Copyright>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/schlagerdk/VNS.Umbraco.PropertyEditors</PackageProjectUrl>
		<RepositoryUrl>https://github.com/schlagerdk/VNS.Umbraco.PropertyEditors</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<!-- The files in wwwroot are served from /App_Plugins/VNS.MultiLanguageTextbox, where Umbraco finds its package
		     manifest. They are never copied into the site, so removing the package removes them too. -->
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="docs\LICENSE.md" Pack="true" PackagePath="\" />
		<None Include="docs\icon.png" Pack="true" PackagePath="\" />
		<None Include="docs\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<!-- Only for the version range: the package is for Umbraco 17 -->
		<PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0, 18.0.0)" />
	</ItemGroup>
</Project>
